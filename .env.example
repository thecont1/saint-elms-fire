# Google AI / Gemini API key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Google Cloud Firestore (optional — used by src/lib/firestore.ts)
# Locally, the Firestore client uses Application Default Credentials.
# Run `gcloud auth application-default login` to set these up.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_DATABASE_ID=(default)

# Sarvam AI fallback model (optional — used for multilingual generation)
# SARVAM_API_KEY=your-sarvam-api-key-here

# Auth mode: "demo" for local/dev, "trusted-proxy" for Cloud Run behind IAP
# AUTH_MODE=demo
# DEMO_USER_ID=student-alex
# DEMO_USER_ROLE=admin

# Trusted-proxy mode (production) — store in Secret Manager, never in .env
# AUTH_PROXY_SECRET=your-proxy-secret-here

# Production seed override — set to "true" only during initial demo seeding
# ALLOW_PRODUCTION_SEED=false

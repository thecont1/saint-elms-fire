# Google AI / Gemini API key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Google Cloud Firestore (optional — used by src/lib/firestore.ts)
# Locally, the Firestore client uses Application Default Credentials.
# Run `gcloud auth application-default login` to set these up.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_DATABASE_ID=(default)

# Sarvam AI fallback model (optional — used for multilingual generation)
# SARVAM_API_KEY=your-sarvam-api-key-here

# Cloud Storage bucket for generated binary artifacts (PDF notes, podcast
# audio). The bucket must exist; the runtime identity needs
# roles/storage.objectAdmin on it. Defaults to saint-elms-fire-artifacts.
# ARTIFACT_BUCKET=saint-elms-fire-artifacts

# Auth mode: "demo" for local/dev, "trusted-proxy" for Cloud Run behind IAP.
# Cloud Run runtime contract: production must run AUTH_MODE=trusted-proxy;
# the deploy script refuses production deploys without it. Background artifact
# jobs additionally require --min-instances=1 --max-instances=1
# --no-cpu-throttling on the Cloud Run service (see scripts/deploy-cloud-run.sh
# and docs/PHASE3.md) or they hang after the 202 response.
# AUTH_MODE=demo
# DEMO_USER_ID=student-alex
# DEMO_USER_ROLE=admin

# Trusted-proxy mode (production) — bound from Secret Manager
# (saint-elms-auth-proxy-secret) at deploy time by scripts/deploy-cloud-run.sh.
# Never place the production value in a local .env; locally, only needed if
# running `next start` in trusted-proxy mode.
# AUTH_PROXY_SECRET=your-proxy-secret-here

# Production seed override — set to "true" only during initial demo seeding
# ALLOW_PRODUCTION_SEED=false

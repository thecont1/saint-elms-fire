# Copy to .env and fill in. Never commit .env.
GOOGLE_CLOUD_PROJECT=saint-elms-fire
FIRESTORE_DATABASE_ID=(default)

# Gemini Developer API key (Genkit googleAI plugin)
GEMINI_API_KEY=

# Only needed outside local dev / when not using an attached service account:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

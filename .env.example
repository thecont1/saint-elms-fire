# Google AI / Gemini API key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Google Cloud Firestore (optional — used by src/lib/firestore.ts)
# Locally, the Firestore client uses Application Default Credentials.
# Run `gcloud auth application-default login` to set these up.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_DATABASE_ID=(default)

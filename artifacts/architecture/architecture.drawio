<mxfile host="Saint-Elms-Fire" compressed="false" version="24.7.17">
  <diagram id="architecture" name="Saint Elms Fire Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cloudrun" value="Cloud Run (Flags Annotated)" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;fillColor=#F3F6F9;strokeColor=#2E6EA5;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontFamily=Instrument Sans;fontSize=14;fontColor=#0B1F3D;"><mxGeometry x="80" y="60" width="1240" height="920" as="geometry"/></mxCell>
        <mxCell id="nextjs" value="&lt;b&gt;Next.js (Cloud Run)&lt;/b&gt;&lt;br/&gt;• Renders all UI: course catalog, lesson viewer, constellation, chat&lt;br/&gt;• Exposes API routes: /api/chat, /api/artifacts&lt;br/&gt;• Client-side state: student switcher, constellation zoom/pan&lt;br/&gt;&lt;i&gt;Flags:&lt;/i&gt;&lt;br/&gt;• ENABLE_SOCRATIC_BEACON&lt;br/&gt;• ENABLE_MULTIMODAL_ARTIFACTS&lt;br/&gt;• RAG_SIMILARITY_THRESHOLD&lt;br/&gt;• RAG_TOP_K" vertex="1" parent="cloudrun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6EA5;strokeWidth=1.5;fontFamily=Instrument Sans;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;spacingBottom=10;spacingRight=10;arcSize=5;"><mxGeometry x="200" y="260" width="260" height="270" as="geometry"/></mxCell>
        <mxCell id="genkit" value="&lt;b&gt;GenKit Flows (Cloud Run)&lt;/b&gt;&lt;br/&gt;• Defines guide-chat, socratic-tutor, multi-format, ingestion&lt;br/&gt;• Routes to Gemini primary / fallback models&lt;br/&gt;• Circuit breaker, retries, RAG grounding&lt;br/&gt;&lt;i&gt;Flags:&lt;/i&gt;&lt;br/&gt;• GENKIT_DEFAULT_MODEL&lt;br/&gt;• GENKIT_FALLBACK_MODEL&lt;br/&gt;• CIRCUIT_BREAKER_THRESHOLD&lt;br/&gt;• CIRCUIT_BREAKER_COOLDOWN_MS" vertex="1" parent="cloudrun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6EA5;strokeWidth=1.5;fontFamily=Instrument Sans;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;spacingBottom=10;spacingRight=10;arcSize=5;"><mxGeometry x="570" y="160" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="gemini" value="&lt;b&gt;Gemini (Primary + Fallback)&lt;/b&gt;&lt;br/&gt;• LLM capabilities: RAG chat, Socratic tutoring, artifacts&lt;br/&gt;• Primary: gemini-3.5-flash (or current 3.5 variant)&lt;br/&gt;• Fallback model configured in GenKit" vertex="1" parent="cloudrun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#2E6EA5;strokeWidth=1.5;fontFamily=Instrument Sans;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;spacingBottom=10;spacingRight=10;arcSize=5;"><mxGeometry x="620" y="560" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="firestore" value="&lt;b&gt;Firestore (Vector + Graph + Releases)&lt;/b&gt;&lt;br/&gt;• Vector store — embeddings for courseware RAG&lt;br/&gt;• Graph store — constellation stars + peer-sharing edges&lt;br/&gt;• Releases + student state — unlocks, metrics, transcripts&lt;br/&gt;&lt;i&gt;Flags:&lt;/i&gt;&lt;br/&gt;• FIRESTORE_VECTOR_COLLECTION&lt;br/&gt;• FIRESTORE_GRAPH_COLLECTION&lt;br/&gt;• FIRESTORE_RELEASES_COLLECTION" vertex="1" parent="cloudrun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6EA5;strokeWidth=1.5;fontFamily=Instrument Sans;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;spacingBottom=10;spacingRight=10;arcSize=5;"><mxGeometry x="980" y="100" width="220" height="240" as="geometry"/></mxCell>
        <mxCell id="gcs" value="&lt;b&gt;GCS (Artifacts)&lt;/b&gt;&lt;br/&gt;• Multimodal artifacts: notes (PDF/Markdown), podcasts (audio)&lt;br/&gt;• Signed URLs for secure, time-limited access&lt;br/&gt;&lt;i&gt;Flags:&lt;/i&gt;&lt;br/&gt;• GCS_BUCKET_NAME&lt;br/&gt;• GCS_SIGNED_URL_EXPIRY_MS" vertex="1" parent="cloudrun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#2E6EA5;strokeWidth=1.5;fontFamily=Instrument Sans;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;spacingBottom=10;spacingRight=10;arcSize=5;"><mxGeometry x="1000" y="400" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="secret" value="&lt;b&gt;Secret Manager (Auth Proxy Secret)&lt;/b&gt;&lt;br/&gt;• Gemini API / service account credentials&lt;br/&gt;• GCS and Firestore credentials (if not default SA)&lt;br/&gt;• Auth proxy secret for secure backend comms&lt;br/&gt;&lt;i&gt;Flags:&lt;/i&gt;&lt;br/&gt;• SECRET_NAME_GEMINI&lt;br/&gt;• SECRET_NAME_GCS&lt;br/&gt;• SECRET_NAME_AUTH_PROXY" vertex="1" parent="cloudrun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6EA5;strokeWidth=1.5;fontFamily=Instrument Sans;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;spacingBottom=10;spacingRight=10;arcSize=5;"><mxGeometry x="980" y="590" width="220" height="170" as="geometry"/></mxCell>
        <mxCell id="student" value="&lt;b&gt;Student / Internet&lt;/b&gt;&lt;br/&gt;• Opens chat UI in Next.js&lt;br/&gt;• Asks questions, views artifacts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E5F3;strokeColor=#0B1F3D;strokeWidth=1.5;fontFamily=Instrument Sans;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;spacingBottom=10;spacingRight=10;arcSize=5;"><mxGeometry x="80" y="430" width="130" height="100" as="geometry"/></mxCell>
